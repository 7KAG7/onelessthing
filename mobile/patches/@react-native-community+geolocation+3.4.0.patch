+static RNCGeolocationOptions RNCGeolocationOptionsFromSpec(JS::NativeRNCGeolocation::GeolocationOptions &options)
+{
+  NSMutableDictionary *values = [NSMutableDictionary new];
+  if (options.timeout().has_value()) values[@"timeout"] = @(options.timeout().value());
+  if (options.maximumAge().has_value()) values[@"maximumAge"] = @(options.maximumAge().value());
+  if (options.enableHighAccuracy().has_value()) values[@"enableHighAccuracy"] = @(options.enableHighAccuracy().value());
+  if (options.distanceFilter().has_value()) values[@"distanceFilter"] = @(options.distanceFilter().value());
+  if (options.useSignificantChanges().has_value()) values[@"useSignificantChanges"] = @(options.useSignificantChanges().value());
+  return [RCTConvert RNCGeolocationOptions:values];
+}
